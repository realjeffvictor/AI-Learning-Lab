# Copy to backend/.env (git-ignored). scripts/setup_db.sh writes the secret values for you.
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL connection (written by scripts/setup_db.sh):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/ailab

# At least 32 random characters. Generate with: openssl rand -hex 32
# JWT_SECRET=

# false for local http development; MUST be true in production (https).
COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=14

# AI assistants (Phase 5). Use ./scripts/set_openai_key.sh to store the key without it appearing on screen.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_DAILY_REQUEST_LIMIT=40
# AI_DAILY_TOKEN_LIMIT=100000
# AI_MAX_OUTPUT_TOKENS=900
# AI_TIMEOUT_SECONDS=45
